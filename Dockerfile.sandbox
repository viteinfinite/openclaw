FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    git \
    jq \
    python3 \
    python3-pip \
    ripgrep \
  && rm -rf /var/lib/apt/lists/* \
  && pip3 install --break-system-packages uv

CMD ["sleep", "infinity"]
